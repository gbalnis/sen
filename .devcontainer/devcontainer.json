// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "SEN",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/python:1.8.0": {
				"version": "3.15.2"
		},
		"ghcr.io/devcontainers/features/go:1.4.0": {
			"version": "1.27.3"
		},
		// "ghcr.io/devcontainers/features/github-cli:1.1.3": {
		// 	"version": "2.103.3"
		// },
		// "ghcr.io/devcontainers/features/copilot-cli:1.1.3": {
		// 	"version": "1.0.105"
		// },
		"ghcr.io/postfinance/devcontainer-features/apm:1.1.0": {
			"version": "0.35.0"
		},
		"ghcr.io/postfinance/devcontainer-features/opencode:1.1.0": {
			"version": "2.2.5"
		},
		"ghcr.io/devcontainers/features/hugo:1.1.3": {
			"version": "0.169.0"
		}
	},

	// To forward the Hugo port from the container to the host using devcontainer CLI, uncomment the following line.
	// "runArgs": ["--publish", "1313:1313"]
	
	// load environment variables from .env file
	"runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [1313],
	"portsAttributes": {
    	"1313": { "label": "Hugo", "onAutoForward": "notify" }
  	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bash .devcontainer/scripts/install-calibre.sh && apm install --target opencode,vscode"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
